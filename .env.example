# Optional. The app never includes a key. Use your own value locally.
GEMINI_API_KEY=YOUR_API_KEY_HERE
# Keep this configurable because model availability changes over time.
GEMINI_MODEL=gemini-3.6-flash

# Optional. OpenAI is an opt-in high-quality AI mode; Gemini remains the default.
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_MODEL=gpt-5.6-terra

# Alibaba Cloud Model Studio / DashScope (Qwen3.7-Plus)
DASHSCOPE_API_KEY=YOUR_API_KEY_HERE
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek supports state-aware text adjustment in this release. It is not
# declared as a visual provider unless the selected model/API actually supports images.
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Custom OpenAI-compatible service (optional)
AI_LIGHTROOM_CUSTOM_API_KEY=YOUR_API_KEY_HERE
AI_LIGHTROOM_CUSTOM_BASE_URL=https://your-provider.example/v1
AI_LIGHTROOM_CUSTOM_MODEL=YOUR_MODEL_ID

# Optional JarvisArt Local discovery. The model and runtime remain separate.
AI_LIGHTROOM_JARVISART_ROOT=YOUR_JARVISART_ROOT
